---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TraceTimeline from '../components/TraceTimeline.astro';
import ConfigPanel from '../components/ConfigPanel.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { resume } from '../data/resume';

const title = `${resume.identity.name} — ${resume.identity.role}`;
const description = resume.identity.tagline;
const year = new Date().getFullYear();
---
<Layout title={title} description={description} backdropVariant="grid">
  <main class="page">
    <Hero />

    {resume.about && (
      <section class="about-section" data-anim="reveal">
        <p class="about">{resume.about}</p>
      </section>
    )}

    <section class="trace-section">
      <div class="label-eyebrow" data-anim="reveal">Career trace</div>
      <TraceTimeline items={resume.experience} />
    </section>

    <ConfigPanel />

    <footer class="site-footer">
      <ContactLinks links={resume.identity.contact} />
      <p class="copyright font-mono">© {year} {resume.identity.name}</p>
    </footer>
  </main>
</Layout>

<script>
  import '../scripts/animations.client.ts';
</script>

<style>
  .page {
    max-width: 760px;
    margin: 0 auto;
    padding: 3rem 1.25rem 5rem;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }
  .about {
    color: var(--mist);
    line-height: 1.7;
    font-size: 1.02rem;
    max-width: 68ch;
    margin: 0;
  }
  .trace-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .site-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--hairline);
  }
  .copyright {
    color: var(--mist-dim);
    font-size: 0.78rem;
    margin: 0;
  }

  @media (min-width: 640px) {
    .page { padding: 4rem 2rem 6rem; }
  }
</style>
