---
import '@fontsource-variable/vazirmatn';
import '@fontsource-variable/figtree';
import '../../styles/harfpeach.css';
import HpThemeInit from '../../components/harfpeach/HpThemeInit.astro';
import HpThemeToggle from '../../components/harfpeach/HpThemeToggle.astro';
import HpFooter from '../../components/harfpeach/HpFooter.astro';
import HpSmoothScroll from '../../components/harfpeach/HpSmoothScroll.astro';

const title = 'حرف‌پیچ | Harf Peach - بازی کلمه‌سازی فارسی';
const description =
  'حرف‌پیچ یک بازی کلمه‌سازی فارسی است: صدها مرحله‌ی تک‌نفره و مسابقه‌ی زنده‌ی یک‌به‌یک. از بازار، مایکت و گوگل‌پلی دریافت کنید.';
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/harfpeach/og.png', Astro.site).toString();

const pkg = 'com.sepehrios.harfpeach.android';
const stores = [
  { id: 'bazaar', href: `https://cafebazaar.ir/app/${pkg}`, img: '/harfpeach/badge-bazaar-fa.png', alt: 'دریافت از بازار', w: 421, h: 125 },
  { id: 'myket', href: `https://myket.ir/app/${pkg}`, img: '/harfpeach/badge-myket-fa.png', alt: 'دریافت از مایکت', w: 1000, h: 333 },
  { id: 'googleplay', href: `https://play.google.com/store/apps/details?id=${pkg}`, img: '/harfpeach/badge-googleplay-fa.png', alt: 'دریافت از Google Play', w: 646, h: 250 },
];

// The demo wheel. Positions follow the game's WheelLayout: node i sits at
// angle -pi/2 - 2*pi*i/N, so four letters land top, left, bottom, right.
const WHEEL_SIZE = 320;
const RING = 106;
const NODE = 38;
const letters = ['ه', 'س', 'و', 'ل'];
const answers = ['سهل', 'لوس', 'هوس'];
const centers = letters.map((_, i) => {
  const a = -Math.PI / 2 - (2 * Math.PI * i) / letters.length;
  return [Math.round(WHEEL_SIZE / 2 + RING * Math.cos(a)), Math.round(WHEEL_SIZE / 2 + RING * Math.sin(a))];
});
const wheelConfig = {
  size: WHEEL_SIZE,
  centers,
  // Same forgiveness as the game: 1.3x the node radius, capped so that
  // neighbouring hit regions can touch but never overlap.
  hitRadius: Math.min(NODE * 1.3, RING * Math.sin(Math.PI / letters.length)),
  letters,
  answers,
};
const star = 'M12 2.8l2.8 5.7 6.3.9-4.6 4.4 1.1 6.3L12 17.1l-5.6 3 1.1-6.3-4.6-4.4 6.3-.9z';
---
<!DOCTYPE html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/harfpeach/favicon.png" />
    <link rel="apple-touch-icon" href="/harfpeach/apple-touch-icon.png" />
    <meta name="theme-color" content="#FFEBDD" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1D1310" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="fa_IR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preload" as="image" href="/harfpeach/icon.webp" />
    <HpThemeInit />
  </head>
  <body>
    <div class="hp">
      <header class="hp-header">
        <div class="hp-wrap hp-nav">
          <a href="#top" class="hp-brand">
            <img src="/harfpeach/icon.webp" alt="" width="44" height="44" />
            <span class="hp-brand-text">
              <span class="hp-brand-fa">حرف‌پیچ</span>
              <span class="hp-brand-en" lang="en" dir="ltr">Harf Peach</span>
            </span>
          </a>
          <nav class="hp-nav-links" aria-label="بخش‌ها">
            <a href="#try">امتحانش کن</a>
            <a href="#modes">حالت‌های بازی</a>
            <a href="#features">امکانات</a>
          </nav>
          <div class="hp-nav-actions">
            <HpThemeToggle />
            <a href="#download" class="hp-candy hp-btn-peach hp-btn-sm">دانلود</a>
          </div>
        </div>
      </header>

      <main>
        <section id="top" class="hp-hero-sec">
          <div class="hp-blob hp-blob-peach" aria-hidden="true"></div>
          <div class="hp-blob hp-blob-green" aria-hidden="true"></div>
          <div class="hp-wrap hp-hero-inner">
            <div class="hp-hero">
              <div class="hp-hero-copy">
                <span class="hp-chip hp-rise">بازی کلمه‌سازی فارسی</span>
                <h1 class="hp-h1 hp-rise hp-d1">حرف‌ها را به هم وصل کن، <span class="hp-ink-peach">کلمه بساز.</span></h1>
                <p class="hp-lead hp-rise hp-d2">صدها مرحله‌ی تک‌نفره، و مسابقه‌ی زنده‌ی یک‌به‌یک با بازیکن‌های دیگر روی یک جدول مشترک.</p>
                <div class="hp-hero-ctas hp-rise hp-d3">
                  <a href="#download" class="hp-candy hp-btn-peach hp-btn-lg">دانلود بازی</a>
                  <a href="#try" class="hp-candy hp-btn-plain hp-btn-lg">امتحانش کن</a>
                </div>
              </div>
              <div class="hp-hero-art">
                <div class="hp-hero-disc" aria-hidden="true"></div>
                <img class="hp-hero-icon hp-bob" src="/harfpeach/icon.webp" width="340" height="340" alt="آیکون حرف‌پیچ: چهار کاشی حرف، ه ل و س، روی یک دایره" fetchpriority="high" />
                <img class="hp-hero-coin hp-bob2" src="/harfpeach/coin.webp" width="96" height="96" alt="" />
                <img class="hp-hero-gem hp-bob2" src="/harfpeach/gem.webp" width="84" height="84" alt="" />
              </div>
            </div>
          </div>
        </section>

        <section id="try" class="hp-sec hp-band hp-try-sec">
          <div class="hp-wrap hp-try">
            <div class="hp-try-copy">
              <h2 class="hp-h2">همین‌جا امتحانش کن</h2>
              <p class="hp-body">موس یا انگشتت را روی حرف‌ها بکش و رها کن تا کلمه ساخته شود. در این چهار حرف سه کلمه پنهان شده.</p>
              <div class="hp-answers">
                {answers.map((w) => (
                  <div class="hp-answer" data-word={w}>
                    {w.split('').map((ch) => <span class="hp-cell">{ch}</span>)}
                  </div>
                ))}
              </div>
              <p class="hp-msg" id="hp-msg" role="status">سه کلمه‌ی سه‌حرفی پیدا کن.</p>
            </div>
            <div class="hp-try-play">
              <div class="hp-preview" id="hp-preview" aria-hidden="true">...</div>
              <div
                class="hp-wheel"
                id="hp-wheel"
                role="img"
                aria-label="چرخه‌ی حروف ه، س، و، ل. با کشیدن موس یا انگشت روی حرف‌ها کلمه بساز."
                style={`width:${WHEEL_SIZE}px;height:${WHEEL_SIZE}px`}
              >
                <div class="hp-wheel-ring" aria-hidden="true"></div>
                <div class="hp-wheel-face" aria-hidden="true"></div>
                <svg class="hp-wheel-trace" width={WHEEL_SIZE} height={WHEEL_SIZE} viewBox={`0 0 ${WHEEL_SIZE} ${WHEEL_SIZE}`} aria-hidden="true">
                  <polyline id="hp-trace" points="" fill="none" stroke="#FF7A57" stroke-width="13" stroke-linecap="round" stroke-linejoin="round"></polyline>
                </svg>
                {letters.map((ch, i) => (
                  <div
                    class="hp-node"
                    data-node={i}
                    aria-hidden="true"
                    style={`left:${centers[i][0] - NODE}px;top:${centers[i][1] - NODE}px;width:${NODE * 2}px;height:${NODE * 2}px`}
                  >
                    {ch}
                  </div>
                ))}
              </div>
              <button type="button" class="hp-candy hp-btn-plain hp-btn-md" id="hp-reset">از نو</button>
            </div>
          </div>
        </section>

        <section id="modes" class="hp-sec hp-modes-sec">
          <div class="hp-wrap hp-stack">
            <h2 class="hp-h2">دو راه برای بازی</h2>
            <div class="hp-modes">
              <article class="hp-mode hp-mode-campaign">
                <div class="hp-mode-glow" aria-hidden="true"></div>
                <div class="hp-mode-stars" aria-hidden="true">
                  <svg width="40" height="40" viewBox="0 0 24 24" fill="#FFD966" stroke="#FFD966" stroke-width="1.5" stroke-linejoin="round"><path d={star}></path></svg>
                  <svg width="40" height="40" viewBox="0 0 24 24" fill="#FFD966" stroke="#FFD966" stroke-width="1.5" stroke-linejoin="round"><path d={star}></path></svg>
                  <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,.7)" stroke-width="1.5" stroke-linejoin="round"><path d={star}></path></svg>
                </div>
                <h3>بازی تک‌نفره</h3>
                <p>صدها مرحله که آرام‌آرام سخت‌تر می‌شوند. ستاره بگیر، سکه جمع کن و هر وقت خواستی از همان‌جا که ماندی ادامه بده.</p>
              </article>
              <article class="hp-mode hp-mode-online">
                <div class="hp-mode-vs" aria-hidden="true" lang="en">VS</div>
                <img class="hp-mode-gem" src="/harfpeach/gem.webp" width="112" height="112" alt="" loading="lazy" />
                <h3>رقابت آنلاین</h3>
                <p>یک در برابر یک، روی یک جدول مشترک و با الماس. هر کس زودتر کلمه‌ها را پیدا کند، برنده است.</p>
              </article>
            </div>
          </div>
        </section>

        <section id="features" class="hp-sec hp-features-sec">
          <div class="hp-wrap hp-stack">
            <h2 class="hp-h2">بیشتر از یک جدول کلمه</h2>
            <div class="hp-bento">
              <article class="hp-cell-a hp-tile hp-tint-green">
                <div class="hp-chat" aria-hidden="true">
                  <span class="hp-bubble hp-bubble-in">یه دست دیگه؟</span>
                  <span class="hp-bubble hp-bubble-out">بزن بریم!</span>
                </div>
                <h3>دوستانت را بیاور</h3>
                <p>دوست اضافه کن، پیام و عکس و صدا بفرست و ببین چه کسی آنلاین است.</p>
              </article>
              <article class="hp-cell-d hp-tile hp-tint-gold">
                <img class="hp-coins" src="/harfpeach/coins_15000.webp" width="170" height="170" alt="" loading="lazy" />
                <h3>گیر کردی؟ راهنما بگیر</h3>
                <p>با سکه یک حرف را باز کن و به راهت ادامه بده.</p>
              </article>
              <article class="hp-cell-b hp-tile hp-tint-lilac">
                <div class="hp-pin" aria-hidden="true"><span>۴</span><span>۲</span><span>۷</span><span>۱</span></div>
                <h3>اتاق خصوصی</h3>
                <p>یک اتاق با رمز بساز و دوستت را به مسابقه دعوت کن.</p>
              </article>
              <article class="hp-cell-c hp-tile hp-tint-peach">
                <svg class="hp-tile-icon" aria-hidden="true" width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-15.5 6.2L3 16"></path><path d="M3 21v-5h5"></path></svg>
                <h3>یک دست دیگر</h3>
                <p>بعد از هر مسابقه، اگر هر دو بخواهید، همان‌جا دوباره بازی کنید.</p>
              </article>
              <article class="hp-cell-e hp-tile hp-tint-surface hp-tile-row">
                <div class="hp-word" aria-hidden="true"><span>ه</span><span>و</span><span>س</span></div>
                <div class="hp-tile-row-copy">
                  <h3>کلمه‌های اضافه هم حساب‌اند</h3>
                  <p>کلمه‌ای پیدا کردی که در جدول نیست؟ بی‌جایزه نمی‌ماند: سکه می‌گیری و به ستاره‌ات کمک می‌کند.</p>
                </div>
                <img src="/harfpeach/coin.webp" width="64" height="64" alt="" loading="lazy" />
              </article>
            </div>
          </div>
        </section>

        <section id="download" class="hp-sec hp-band hp-download-sec">
          <div class="hp-wrap hp-download">
            <img class="hp-download-icon" src="/harfpeach/icon.webp" width="112" height="112" alt="" loading="lazy" />
            <h2 class="hp-h2">حرف‌پیچ را نصب کن</h2>
            <p class="hp-body">برای اندروید، از فروشگاه دلخواهت.</p>
            <div class="hp-stores">
              {stores.map((s) => (
                <a href={s.href} target="_blank" rel="noopener" class={`hp-badge hp-badge-${s.id}`}>
                  <img src={s.img} alt={s.alt} width={s.w} height={s.h} loading="lazy" />
                </a>
              ))}
            </div>
          </div>
        </section>
      </main>

      <HpFooter />
    </div>

    <HpSmoothScroll />

    <script is:inline define:vars={{ wheelConfig }}>
      (function () {
        // Letter wheel: a port of the game's WheelTrace (harf-peach
        // apps/client/lib/ui/features/game/wheel/wheel_trace.dart).
        var W = wheelConfig;
        var wheel = document.getElementById('hp-wheel');
        var nodes = wheel.querySelectorAll('.hp-node');
        var line = document.getElementById('hp-trace');
        var preview = document.getElementById('hp-preview');
        var msgEl = document.getElementById('hp-msg');
        var path = [];
        var cursor = null;
        var pointerId = null;
        var found = [];

        function local(e) {
          var r = wheel.getBoundingClientRect();
          return [(e.clientX - r.left) * (W.size / r.width), (e.clientY - r.top) * (W.size / r.height)];
        }
        // Nearest node centre within the hit radius, else none.
        function hit(p) {
          var best = null, bestD = Infinity;
          for (var i = 0; i < W.centers.length; i++) {
            var c = W.centers[i];
            var d = Math.hypot(p[0] - c[0], p[1] - c[1]);
            if (d <= W.hitRadius && d < bestD) { best = i; bestD = d; }
          }
          return best;
        }
        function render() {
          for (var i = 0; i < nodes.length; i++) nodes[i].classList.toggle('is-on', path.indexOf(i) !== -1);
          var pts = path.map(function (k) { return W.centers[k].join(','); });
          if (path.length && cursor) pts.push(cursor[0].toFixed(1) + ',' + cursor[1].toFixed(1));
          line.setAttribute('points', pts.join(' '));
          preview.textContent = path.length ? path.map(function (k) { return W.letters[k]; }).join('') : '...';
        }
        function say(text, bad) {
          msgEl.textContent = text;
          msgEl.classList.toggle('is-bad', !!bad);
        }
        // The first node hit starts the path; staying on the last node changes
        // nothing; the previous node pops the last one; any other picked node
        // is ignored; anything else appends. No interpolation between samples.
        function sample(p) {
          var node = hit(p);
          cursor = p;
          if (node != null) {
            if (path.length === 0) path = [node];
            else if (node === path[path.length - 1]) {}
            else if (path.length >= 2 && node === path[path.length - 2]) path = path.slice(0, -1);
            else if (path.indexOf(node) === -1) path = path.concat([node]);
          }
          render();
        }
        function clear() { path = []; cursor = null; render(); }
        // Release: a single-node tap just clears; two or more letters are a guess.
        function commit() {
          if (path.length < 2) { clear(); return; }
          var word = path.map(function (k) { return W.letters[k]; }).join('');
          clear();
          if (W.answers.indexOf(word) === -1) {
            say('«' + word + '» در جدول نیست. دوباره امتحان کن.', true);
          } else if (found.indexOf(word) !== -1) {
            say('«' + word + '» را قبلاً پیدا کرده‌ای.');
          } else {
            found.push(word);
            var row = document.querySelector('.hp-answer[data-word="' + word + '"]');
            if (row) row.classList.add('is-found');
            say(found.length === W.answers.length ? 'آفرین! هر سه کلمه را پیدا کردی.' : 'آفرین! «' + word + '» پیدا شد.');
          }
        }

        wheel.addEventListener('pointerdown', function (e) {
          if (pointerId !== null || (e.pointerType === 'mouse' && e.button !== 0)) return;
          e.preventDefault();
          pointerId = e.pointerId;
          try { wheel.setPointerCapture(e.pointerId); } catch (err) {}
          sample(local(e));
        });
        wheel.addEventListener('pointermove', function (e) {
          if (e.pointerId !== pointerId) return;
          sample(local(e));
        });
        wheel.addEventListener('pointerup', function (e) {
          if (e.pointerId !== pointerId) return;
          pointerId = null;
          commit();
        });
        // The system took the gesture: discard rather than commit.
        wheel.addEventListener('pointercancel', function (e) {
          if (e.pointerId !== pointerId) return;
          pointerId = null;
          clear();
        });

        document.getElementById('hp-reset').addEventListener('click', function () {
          found = [];
          var rows = document.querySelectorAll('.hp-answer');
          for (var i = 0; i < rows.length; i++) rows[i].classList.remove('is-found');
          clear();
          say('سه کلمه‌ی سه‌حرفی پیدا کن.');
        });
      })();
    </script>

    <style is:global>
      .hp-stack { display: flex; flex-direction: column; gap: 40px; }
      .hp-sec { padding-top: 104px; padding-bottom: 104px; }
      .hp-band { position: relative; z-index: 1; background: var(--band); }

      /* Type */
      .hp-h1 { font-size: 60px; line-height: 1.3; font-weight: 900; letter-spacing: -0.01em; }
      .hp-h2 { font-size: 42px; line-height: 1.35; font-weight: 900; }
      .hp-lead { font-size: 20px; line-height: 1.9; max-width: 34ch; color: var(--muted); }
      .hp-body { font-size: 18px; line-height: 1.9; max-width: 40ch; color: var(--muted); }
      .hp-ink-peach { color: var(--peach-ink); }

      .hp-nav-links { display: flex; gap: 28px; font-size: 15px; font-weight: 500; color: var(--muted); }
      .hp-nav-links a:hover { color: var(--text); }
      /* Hero */
      .hp-hero-sec { position: relative; z-index: 0; isolation: isolate; }
      .hp-blob { position: absolute; z-index: -1; border-radius: 50%; }
      .hp-blob-peach { width: 520px; height: 520px; top: -260px; left: -160px; background: var(--blob-peach); }
      .hp-blob-green { width: 420px; height: 420px; bottom: -220px; right: -180px; background: var(--blob-green); }
      .hp-hero-inner { padding-top: 56px; padding-bottom: 96px; }
      .hp-hero { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 48px; align-items: center; }
      .hp-hero-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 22px; }
      .hp-chip { padding: 8px 16px; border-radius: 999px; font-size: 14px; font-weight: 700; background: var(--surface); color: var(--green-ink); box-shadow: 0 3px 0 var(--shadow); }
      .hp-hero-ctas { display: flex; gap: 14px; flex-wrap: wrap; padding-top: 6px; }
      .hp-hero-art { position: relative; display: flex; justify-content: center; align-items: center; min-height: 440px; }
      .hp-hero-disc { position: absolute; width: 400px; height: 400px; max-width: 90%; aspect-ratio: 1; border-radius: 50%; background: var(--surface-2); }
      .hp-hero-icon { --r: -4deg; position: relative; width: 340px; max-width: 78%; height: auto; aspect-ratio: 1; border-radius: 22%; box-shadow: 0 14px 0 var(--icon-shadow); transform: rotate(var(--r)); }
      .hp-hero-coin { --r: 8deg; position: absolute; width: 96px; height: auto; top: 18px; left: 6%; transform: rotate(var(--r)); }
      .hp-hero-gem { --r: -10deg; position: absolute; width: 84px; height: auto; bottom: 26px; right: 4%; transform: rotate(var(--r)); }

      /* Try it */
      .hp-try { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 56px; align-items: center; }
      .hp-try-copy { display: flex; flex-direction: column; gap: 18px; }
      .hp-answers { display: flex; flex-direction: column; gap: 12px; padding-top: 10px; }
      .hp-answer { display: flex; gap: 8px; }
      .hp-cell {
        width: 52px; height: 52px; border-radius: 14px; display: flex; align-items: center; justify-content: center;
        font-size: 24px; font-weight: 800; color: transparent;
        background: var(--surface); box-shadow: inset 0 0 0 2px var(--border);
      }
      .hp-answer.is-found .hp-cell { color: #FFFFFF; background: var(--leaf-face); box-shadow: 0 4px 0 var(--leaf-shadow); }
      .hp-msg { min-height: 32px; font-size: 16px; font-weight: 700; color: var(--msg-good); }
      .hp-msg.is-bad { color: var(--msg-bad); }
      .hp-try-play { display: flex; flex-direction: column; align-items: center; gap: 22px; }
      .hp-preview {
        min-width: 160px; height: 52px; padding: 0 22px; border-radius: 16px;
        display: flex; align-items: center; justify-content: center;
        font-size: 26px; font-weight: 800; letter-spacing: .06em;
        background: var(--surface); box-shadow: 0 4px 0 var(--shadow);
      }
      .hp-wheel { position: relative; flex-shrink: 0; touch-action: none; user-select: none; -webkit-user-select: none; cursor: grab; }
      .hp-wheel:active { cursor: grabbing; }
      .hp-wheel-ring { position: absolute; inset: 0; border-radius: 50%; background: var(--wheel-ring); }
      .hp-wheel-face { position: absolute; inset: 12px; border-radius: 50%; background: var(--wheel-face); }
      .hp-wheel-trace { position: absolute; inset: 0; overflow: visible; pointer-events: none; }
      .hp-node {
        position: absolute; pointer-events: none; border-radius: 22px;
        display: flex; align-items: center; justify-content: center;
        font-size: 38px; font-weight: 800; line-height: 1; color: #FFFFFF;
        background: #FFB067; box-shadow: 0 6px 0 #E88F3E;
        transition: background-color .12s ease, transform .12s ease;
      }
      .hp-node.is-on { background: #FF7A57; box-shadow: 0 6px 0 #D9502F; transform: scale(1.06); }

      /* Modes */
      .hp-modes-sec { padding-top: 112px; padding-bottom: 72px; }
      .hp-modes { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 24px; }
      .hp-mode {
        position: relative; overflow: hidden; border-radius: 32px; padding: 44px; min-height: 340px;
        display: flex; flex-direction: column; justify-content: flex-end; gap: 14px; color: #FFFFFF;
      }
      .hp-mode h3 { position: relative; font-size: 34px; font-weight: 900; }
      .hp-mode p { position: relative; font-size: 18px; line-height: 1.9; max-width: 36ch; }
      .hp-mode-campaign { background: var(--peach-face); box-shadow: 0 10px 0 var(--peach-shadow); }
      .hp-mode-online { background: var(--purple-face); box-shadow: 0 10px 0 var(--purple-shadow); }
      .hp-mode-glow { position: absolute; width: 280px; height: 280px; border-radius: 50%; background: rgba(255, 255, 255, .12); top: -90px; left: -70px; }
      .hp-mode-stars { position: absolute; top: 40px; left: 44px; display: flex; gap: 6px; }
      .hp-mode-vs {
        position: absolute; top: 36px; left: 40px; width: 76px; height: 76px; border-radius: 22px;
        display: flex; align-items: center; justify-content: center;
        background: #FFFFFF; color: var(--purple-face); font-size: 30px; font-weight: 800;
      }
      .hp-mode-gem { position: absolute; width: 112px; height: auto; top: 26px; right: 30px; transform: rotate(12deg); }

      /* Features bento */
      .hp-features-sec { padding-top: 72px; padding-bottom: 112px; }
      .hp-bento { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-areas: "a a d" "b c d" "e e e"; gap: 20px; }
      .hp-cell-a { grid-area: a; } .hp-cell-b { grid-area: b; } .hp-cell-c { grid-area: c; } .hp-cell-d { grid-area: d; } .hp-cell-e { grid-area: e; }
      .hp-tile { border-radius: 28px; padding: 32px; min-height: 220px; display: flex; flex-direction: column; justify-content: flex-end; gap: 10px; }
      .hp-tile h3 { font-size: 24px; font-weight: 800; }
      .hp-tile p { font-size: 16px; line-height: 1.85; color: var(--muted); max-width: 44ch; }
      .hp-cell-a, .hp-cell-d { padding: 36px; min-height: 240px; }
      .hp-cell-a h3, .hp-cell-d h3 { font-size: 26px; }
      .hp-cell-a p, .hp-cell-d p { font-size: 17px; }
      .hp-tint-green { background: var(--green-tint); box-shadow: 0 6px 0 var(--green-edge); }
      .hp-tint-gold { background: var(--gold-tint); box-shadow: 0 6px 0 var(--gold-edge); }
      .hp-tint-lilac { background: var(--lilac-tint); box-shadow: 0 6px 0 var(--lilac-edge); }
      .hp-tint-peach { background: var(--peach-tint); box-shadow: 0 6px 0 var(--peach-edge); }
      .hp-tint-surface { background: var(--surface); box-shadow: 0 6px 0 var(--shadow); }
      .hp-chat { display: flex; gap: 8px; margin-bottom: auto; flex-wrap: wrap; }
      .hp-bubble { padding: 10px 16px; font-size: 15px; font-weight: 500; }
      .hp-bubble-in { border-radius: 18px 18px 18px 6px; background: var(--surface); color: var(--text); }
      .hp-bubble-out { border-radius: 18px 18px 6px 18px; background: var(--leaf-face); color: #FFFFFF; }
      .hp-coins { width: 170px; height: auto; align-self: center; margin-bottom: auto; }
      .hp-pin { display: flex; gap: 6px; margin-bottom: auto; direction: ltr; }
      .hp-pin span {
        width: 40px; height: 46px; border-radius: 12px; display: flex; align-items: center; justify-content: center;
        font-size: 22px; font-weight: 800; background: var(--surface); color: var(--lilac-ink);
      }
      .hp-tile-icon { margin-bottom: auto; color: var(--peach-ink); }
      .hp-tile-row { min-height: 0; flex-direction: row; align-items: center; gap: 28px; flex-wrap: wrap; padding: 32px 36px; }
      .hp-tile-row-copy { flex: 1 1 320px; display: flex; flex-direction: column; gap: 6px; }
      .hp-tile-row img { width: 64px; height: auto; }
      .hp-word { display: flex; gap: 8px; }
      .hp-word span {
        width: 52px; height: 52px; border-radius: 14px; display: flex; align-items: center; justify-content: center;
        font-size: 24px; font-weight: 800; color: #FFFFFF; background: var(--leaf-face); box-shadow: 0 4px 0 var(--leaf-shadow);
      }

      /* Download */
      .hp-download { display: flex; flex-direction: column; align-items: center; gap: 28px; text-align: center; }
      .hp-download-icon { width: 112px; height: 112px; border-radius: 28px; box-shadow: 0 8px 0 var(--icon-shadow); }
      .hp-stores { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 20px 24px; padding-top: 8px; }
      .hp-badge { display: block; line-height: 0; border-radius: 10px; transition: transform .16s var(--ease); }
      .hp-badge:hover { transform: translateY(-2px); }
      .hp-badge:active { transform: translateY(1px); }
      .hp-badge img { width: auto; }
      .hp-badge-bazaar img { height: 58px; }
      .hp-badge-myket img { height: 62px; }
      /* Google's badge image carries its own clear space; offset it so the
         visible badge lines up with the other two. */
      .hp-badge-googleplay { margin: -15px -12px; }
      .hp-badge-googleplay img { height: 88px; }

      /* Motion */
      @media (prefers-reduced-motion: no-preference) {
        .hp-rise { animation: hp-rise .7s var(--ease) both; }
        .hp-d1 { animation-delay: .08s; }
        .hp-d2 { animation-delay: .16s; }
        .hp-d3 { animation-delay: .24s; }
        .hp-bob { animation: hp-bob 5s ease-in-out infinite; }
        .hp-bob2 { animation: hp-bob 6s 1.2s ease-in-out infinite; }
      }
      @media (prefers-reduced-motion: reduce) {
        .hp-candy, .hp-badge, .hp-node { transition: none; }
      }
      @keyframes hp-rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
      @keyframes hp-bob {
        0%, 100% { transform: translateY(0) rotate(var(--r, 0deg)); }
        50% { transform: translateY(-10px) rotate(var(--r, 0deg)); }
      }

      /* Small screens */
      @media (max-width: 900px) {
        .hp-wrap { padding: 0 16px; }
        .hp-nav-links { display: none; }
        .hp-hero, .hp-try, .hp-modes { grid-template-columns: minmax(0, 1fr); gap: 32px; }
        .hp-bento { grid-template-columns: minmax(0, 1fr); grid-template-areas: "a" "b" "c" "d" "e"; }
        .hp-h1 { font-size: 40px; }
        .hp-h2 { font-size: 30px; }
        .hp-sec, .hp-modes-sec, .hp-features-sec { padding-top: 64px; padding-bottom: 64px; }
        .hp-hero-inner { padding-top: 32px; padding-bottom: 64px; }
        .hp-hero-art { min-height: 340px; }
        .hp-mode { padding: 32px; min-height: 300px; }
        .hp-mode h3 { font-size: 28px; }
      }
      @media (max-width: 420px) {
        .hp-stores { flex-direction: column; }
        .hp-btn-lg { height: 56px; padding: 0 22px; font-size: 17px; }
      }
    </style>
  </body>
</html>
