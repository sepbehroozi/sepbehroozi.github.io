---
import HarfPeachDoc from '../../layouts/HarfPeachDoc.astro';
import HpLegalDoc from '../../components/harfpeach/HpLegalDoc.astro';
import { compiledContent as enContent } from '../../legal/harfpeach/privacy_policy.en.md';
import { compiledContent as faContent } from '../../legal/harfpeach/privacy_policy.fa.md';

const enHtml = await enContent();
const faHtml = await faContent();
---
<HarfPeachDoc
  current="privacy"
  description="Privacy policy for the Harf Peach mobile game."
  en={{
    title: 'Privacy Policy | Harf Peach',
    heading: 'Privacy Policy',
    lead: 'What Harf Peach collects, why, and the choices you have.',
  }}
  fa={{
    title: 'سیاست حفظ حریم خصوصی | حرف‌پیچ',
    heading: 'سیاست حفظ حریم خصوصی',
    lead: 'حرف‌پیچ چه اطلاعاتی جمع می‌کند، برای چه، و چه اختیاری دارید.',
  }}
>
  <HpLegalDoc enHtml={enHtml} faHtml={faHtml} />
</HarfPeachDoc>
