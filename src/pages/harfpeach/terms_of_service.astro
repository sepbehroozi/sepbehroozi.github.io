---
import HarfPeachDoc from '../../layouts/HarfPeachDoc.astro';
import HpLegalDoc from '../../components/harfpeach/HpLegalDoc.astro';
import { compiledContent as enContent } from '../../legal/harfpeach/terms_of_service.en.md';
import { compiledContent as faContent } from '../../legal/harfpeach/terms_of_service.fa.md';

const enHtml = await enContent();
const faHtml = await faContent();
---
<HarfPeachDoc
  current="terms"
  description="Terms of service for the Harf Peach mobile game."
  en={{
    title: 'Terms of Service | Harf Peach',
    heading: 'Terms & Conditions',
    lead: 'The rules for using Harf Peach and what you agree to by playing.',
  }}
  fa={{
    title: 'شرایط و ضوابط | حرف‌پیچ',
    heading: 'شرایط و ضوابط',
    lead: 'قوانین استفاده از حرف‌پیچ و آنچه با بازی کردن می‌پذیرید.',
  }}
>
  <HpLegalDoc enHtml={enHtml} faHtml={faHtml} />
</HarfPeachDoc>
