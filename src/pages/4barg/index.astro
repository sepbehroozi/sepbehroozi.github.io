  <script is:inline define:vars={{ titles }}>
    // Language toggle: flips language, direction, tab title and `?lang=`
    // (so the view can be shared), swaps translated alt texts and labels, and
    // carries English over to the legal pages (Persian is their default).
    (function () {
      var root = document.documentElement;
      function sync(lang) {
        document.querySelectorAll('a[data-keep-lang]').forEach(function (a) {
          var url = new URL(a.getAttribute('href'), window.location.href);
          if (lang === 'en') url.searchParams.set('lang', 'en');
          else url.searchParams.delete('lang');
          a.setAttribute('href', url.pathname + url.search + url.hash);
        });
        ['alt', 'aria-label'].forEach(function (attr) {
          document.querySelectorAll('[data-' + attr + '-' + lang + ']').forEach(function (el) {
            el.setAttribute(attr, el.getAttribute('data-' + attr + '-' + lang));
          });
        });
      }
      function apply(lang) {
        root.setAttribute('data-lang', lang);
        root.lang = lang;
        root.dir = lang === 'fa' ? 'rtl' : 'ltr';
        document.title = titles[lang];
        var url = new URL(window.location.href);
        url.searchParams.set('lang', lang);
        window.history.replaceState(null, '', url.pathname + url.search + url.hash);
        sync(lang);
      }
      sync(root.getAttribute('data-lang') === 'en' ? 'en' : 'fa');
      document.querySelectorAll('[data-lang-toggle]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          apply(root.getAttribute('data-lang') === 'en' ? 'fa' : 'en');
        });
      });
    })();
  </script>
</Layout>

