---
import '@fontsource-variable/vazirmatn';
import Layout from '../../layouts/Layout.astro';

const titles = {
  en: '4Barg — Traditional Persian Card Game',
  fa: 'چهاربرگ — بازی کارتی سنتی ایرانی',
};
const description = "Play the classic Persian card game 4Barg (چهار برگ) online with players worldwide or offline against smart AI bots. Features real-time voice chat, lobbies, and global leaderboards.";
---

<Layout title={titles.fa} description={description} lang="fa">
  <script is:inline slot="head" define:vars={{ titles }}>
    // Persian is the default; `?lang=en` switches to English (`?lang=fa`
    // asks for Persian explicitly). Decided before first paint, so the right
    // language shows without a flash.
    (function () {
      try {
        var lang = new URLSearchParams(window.location.search).get('lang') === 'en' ? 'en' : 'fa';
        var root = document.documentElement;
        root.setAttribute('data-lang', lang);
        root.lang = lang;
        root.dir = lang === 'fa' ? 'rtl' : 'ltr';
        document.title = titles[lang];
      } catch (e) {}
    })();
  </script>
  <main class="page-container relative z-10">
    <!-- Back to portfolio button -->
    <nav class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
      <a href="/" class="back-link group" id="nav-back-portfolio">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 mr-2 transition-transform group-hover:-translate-x-1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        <span data-lang-block="en">Back to Portfolio</span><span data-lang-block="fa">بازگشت به نمونه‌کارها</span>
      </a>
      <div class="flex items-center gap-4">
        <span class="text-xs font-semibold uppercase tracking-widest text-[#6b8f8a] tabular-nums"><span data-lang-block="en">Version 2.2.2</span><span data-lang-block="fa">نسخه‌ی ۲.۲.۲</span></span>
        <button type="button" class="lang-toggle" data-lang-toggle>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18" />
            <path d="M12 3c2.5 2.5 3.8 5.7 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.7-3.8-9S9.5 5.5 12 3z" />
          </svg>
          <span data-lang-block="fa" lang="en">English</span>
          <span data-lang-block="en" lang="fa">فارسی</span>
        </button>
      </div>
    </nav>

    <!-- Hero Section -->
    <section class="max-w-7xl mx-auto px-6 py-12 md:py-20 lg:py-28 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center" id="section-hero">
      <!-- Left content column -->
      <div class="lg:col-span-7 space-y-8">
        <div class="flex items-center space-x-4">
          <img src="/4barg/logo.png" alt="4Barg Logo" data-alt-en="4Barg Logo" data-alt-fa="لوگوی چهاربرگ" class="w-16 h-16 rounded-2xl shadow-xl border-2 border-[#ffd65a] p-0.5 bg-[#030d0b]" id="hero-logo-img" />
          <div>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-white mb-1">
              4Barg <span class="gold-text-gradient font-bold text-3xl md:text-4xl lg:text-5xl block md:inline md:ml-2">چهار برگ</span>
            </h1>
            <p class="text-xs uppercase tracking-widest text-[#ffd65a] font-semibold"><span data-lang-block="en">Traditional Persian Card Game</span><span data-lang-block="fa">بازی کارتی سنتی ایرانی</span></p>
          </div>
        </div>

        <p class="text-lg md:text-xl text-[#a2beba] leading-relaxed max-w-2xl">
          <span data-lang-block="en">The classic card game, rebuilt from the ground up for modern devices. Challenge players globally in real-time rooms, coordinate tactics with in-game voice chat, or play offline anywhere against our smart AI.</span><span data-lang-block="fa">بازی کارتی کلاسیک، از نو برای گوشی‌های امروزی ساخته شده است. در اتاق‌های زنده با بازیکنان سراسر دنیا رقابت کنید، با گفت‌وگوی صوتی درون بازی با یارتان هماهنگ شوید، یا هر جا که هستید به‌صورت آفلاین مقابل هوش مصنوعی بازی کنید.</span>
        </p>

        <!-- Download CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 pt-4" id="download-ctas">
          <!-- iOS App Store -->
          <a href="https://apps.apple.com/app/id6779758684" target="_blank" rel="noopener noreferrer" class="appstore-img-link" id="cta-app-store">
            <img src="/4barg/download-appstore.svg" alt="Download on the App Store" class="h-[52px] w-auto" />
          </a>

          <!-- CafeBazaar -->
          <a href="https://cafebazaar.ir/app/com.sharif.a4Barg" target="_blank" rel="noopener noreferrer" class="bazaar-img-link" id="cta-cafebazaar">
            <img src="/4barg/get-cafebazaar-en.png" alt="Get it on CafeBazaar" class="h-[52px] w-auto" data-lang-block="en" />
            <img src="/4barg/get-cafebazaar-fa.png" alt="دریافت از بازار" class="h-[52px] w-auto" data-lang-block="fa" />
          </a>

          <!-- Myket -->
          <a href="https://myket.ir/app/com.sharif.a4Barg" target="_blank" rel="noopener noreferrer" class="myket-img-link" id="cta-myket">
            <img src="/4barg/download-myket.svg" alt="Download via Myket" class="h-[52px] w-auto" data-lang-block="en" />
            <img src="/4barg/download-myket-fa.png" alt="دریافت از مایکت" class="h-[52px] w-auto" data-lang-block="fa" />
          </a>
        </div>
      </div>

      <!-- Right interactive visual column -->
      <div class="lg:col-span-5 flex justify-center items-center relative py-10" id="hero-card-column">
        <!-- Radial glow behind cards -->
        <div class="absolute w-72 h-72 bg-[#1d5c50] opacity-35 rounded-full filter blur-3xl -z-10 pointer-events-none"></div>

        <!-- Card fan container -->
        <div class="card-fan-container relative w-64 h-96 cursor-pointer" id="interactive-card-fan">
          <!-- Card back (base) -->
          <div class="fan-card card-back" style="--index: 0;">
            <img src="/4barg/card_back.png" alt="Card Back" data-alt-en="Card Back" data-alt-fa="پشت کارت" class="w-full h-full object-cover rounded-xl shadow-2xl border border-emerald-700/50" />
          </div>

          <!-- Hearts King -->
          <div class="fan-card card-face" style="--index: 1;">
            <img src="/4barg/cards/hearts_king.png" alt="King of Hearts" data-alt-en="King of Hearts" data-alt-fa="شاه دل" class="w-full h-full object-contain rounded-xl shadow-2xl" />
          </div>

          <!-- Ace of Clubs -->
          <div class="fan-card card-face" style="--index: 2;">
            <img src="/4barg/cards/clubs_ace.png" alt="Ace of Clubs" data-alt-en="Ace of Clubs" data-alt-fa="تک خاج" class="w-full h-full object-contain rounded-xl shadow-2xl" />
          </div>

          <!-- 10 of Diamonds -->
          <div class="fan-card card-face" style="--index: 3;">
            <img src="/4barg/cards/diamonds_10.png" alt="10 of Diamonds" data-alt-en="10 of Diamonds" data-alt-fa="ده خشت" class="w-full h-full object-contain rounded-xl shadow-2xl" />
          </div>

          <!-- Jack of Spades -->
          <div class="fan-card card-face" style="--index: 4;">
            <img src="/4barg/cards/spades_jack.png" alt="Jack of Spades" data-alt-en="Jack of Spades" data-alt-fa="سرباز پیک" class="w-full h-full object-contain rounded-xl shadow-2xl" />
          </div>
        </div>

        <p class="absolute bottom-0 text-center text-xs text-[#6b8f8a] italic pointer-events-none"><span data-lang-block="en">Hover or tap cards to deal them</span><span data-lang-block="fa">برای پخش کارت‌ها، نشانگر را روی آن‌ها ببرید یا لمسشان کنید</span></p>
      </div>
    </section>

    <!-- Key Features Section -->
    <section class="max-w-7xl mx-auto px-6 py-16 border-t border-[#1d5c50]/30" id="section-features">
      <div class="text-center mb-16 space-y-4">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white"><span data-lang-block="en">Full-Featured Experience</span><span data-lang-block="fa">تجربه‌ای کامل</span></h2>
        <div class="w-20 h-1 bg-gradient-to-r from-[#ffd65a] to-[#ffe4b0] mx-auto rounded-full"></div>
        <p class="text-[#a2beba] max-w-2xl mx-auto"><span data-lang-block="en">Re-engineered with modern infrastructure to deliver the best competitive Persian card game experience.</span><span data-lang-block="fa">با زیرساختی مدرن از نو ساخته شده تا بهترین تجربه‌ی رقابتی بازی کارتی ایرانی را ارائه دهد.</span></p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Feature 1: Real-time multiplayer -->
        <div class="feature-card group" id="feat-multiplayer">
          <div class="feature-icon bg-emerald-950/50 border border-[#1d5c50]/40 text-[#ffd65a]">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white group-hover:text-[#ffd65a] transition-colors"><span data-lang-block="en">Global Matchmaking</span><span data-lang-block="fa">بازی با بازیکنان سراسر دنیا</span></h3>
          <p class="text-[#a2beba] text-sm leading-relaxed">
            <span data-lang-block="en">Create or join 2-player (1v1) or 4-player (2v2 team game) online rooms. Play against friends or match with players worldwide instantly.</span><span data-lang-block="fa">اتاق آنلاین دونفره (یک به یک) یا چهارنفره (بازی تیمی دو به دو) بسازید یا به آن بپیوندید. با دوستانتان بازی کنید یا فوراً با بازیکنانی از سراسر دنیا هم‌بازی شوید.</span>
          </p>
        </div>

        <!-- Feature 2: Voice Chat -->
        <div class="feature-card group" id="feat-voice-chat">
          <div class="feature-icon bg-emerald-950/50 border border-[#1d5c50]/40 text-[#ffd65a]">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 01-3-3V4.5a3 3 0 116 0v8.25a3 3 0 01-3 3z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white group-hover:text-[#ffd65a] transition-colors"><span data-lang-block="en">Real-time Voice Chat</span><span data-lang-block="fa">گفت‌وگوی صوتی زنده</span></h3>
          <p class="text-[#a2beba] text-sm leading-relaxed">
            <span data-lang-block="en">Coordinate strategies with your teammate or chat with opponents live during match play, powered by premium LiveKit voice technology.</span><span data-lang-block="fa">در طول بازی با یارتان نقشه بکشید یا با حریفان به‌صورت زنده گفت‌وگو کنید؛ با فناوری صوتی LiveKit.</span>
          </p>
        </div>

        <!-- Feature 3: Smart AI -->
        <div class="feature-card group" id="feat-ai-bots">
          <div class="feature-icon bg-emerald-950/50 border border-[#1d5c50]/40 text-[#ffd65a]">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white group-hover:text-[#ffd65a] transition-colors"><span data-lang-block="en">Offline Smart Bots</span><span data-lang-block="fa">ربات‌های هوشمند آفلاین</span></h3>
          <p class="text-[#a2beba] text-sm leading-relaxed">
            <span data-lang-block="en">No internet? No problem. Train or relax offline with our state-of-the-art AI. The game replaces leaving players with AI bots in 4p matches automatically.</span><span data-lang-block="fa">اینترنت ندارید؟ مشکلی نیست. با هوش مصنوعی پیشرفته‌ی بازی به‌صورت آفلاین تمرین کنید یا سرگرم شوید. در بازی‌های چهارنفره، اگر بازیکنی بازی را ترک کند، ربات به‌طور خودکار جایش را می‌گیرد.</span>
          </p>
        </div>

        <!-- Feature 4: Social systems -->
        <div class="feature-card group" id="feat-social">
          <div class="feature-icon bg-emerald-950/50 border border-[#1d5c50]/40 text-[#ffd65a]">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9s.25 0 .25.25v5.006c0 .085-.02.17-.057.243l-1.857 3.715a2.25 2.25 0 01-2.012 1.246H9.986a2.25 2.25 0 01-2.012-1.246l-1.857-3.715A.625.625 0 016 13.506V8.5s0-.25.25-.25h1z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.114 1.5 2.085v3.3c0 1.013-.679 1.87-1.637 2.1l-1.777.426a12.09 12.09 0 01-1.011.176V15c0-.967-.35-1.89-.986-2.586l-2.617-2.871A2.25 2.25 0 0115 8.012V7.5a2.25 2.25 0 012.25-2.25h1.5A2.25 2.25 0 0121 7.5v1.011z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white group-hover:text-[#ffd65a] transition-colors"><span data-lang-block="en">Friends & Private Chats</span><span data-lang-block="fa">دوستان و گفت‌وگوی خصوصی</span></h3>
          <p class="text-[#a2beba] text-sm leading-relaxed">
            <span data-lang-block="en">Manage your friends list, block users, send direct messages, and invite online friends straight into your current matchmaking game room.</span><span data-lang-block="fa">فهرست دوستانتان را مدیریت کنید، کاربران را مسدود کنید، پیام مستقیم بفرستید و دوستان آنلاین را مستقیم به اتاق بازی فعلی‌تان دعوت کنید.</span>
          </p>
        </div>

        <!-- Feature 5: Lobbies & Chats -->
        <div class="feature-card group" id="feat-lobbies">
          <div class="feature-icon bg-emerald-950/50 border border-[#1d5c50]/40 text-[#ffd65a]">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 18.97a5.969 5.969 0 01-.774-2.614 7.215 7.215 0 01-.136-.356C3.03 14.556 3 12 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white group-hover:text-[#ffd65a] transition-colors"><span data-lang-block="en">Global Lobby Chat</span><span data-lang-block="fa">گفت‌وگو در لابی</span></h3>
          <p class="text-[#a2beba] text-sm leading-relaxed">
            <span data-lang-block="en">Hang out in the central lobby, chat with players globally, customize parameters (target scores: 32, 62, 122), and plan the next set.</span><span data-lang-block="fa">در لابی اصلی بمانید، با بازیکنان سراسر دنیا گفت‌وگو کنید، تنظیمات بازی (امتیاز هدف: ۳۲، ۶۲، ۱۲۲) را انتخاب کنید و دست بعدی را برنامه‌ریزی کنید.</span>
          </p>
        </div>

        <!-- Feature 6: Shop & Payments -->
        <div class="feature-card group" id="feat-shop">
          <div class="feature-icon bg-emerald-950/50 border border-[#1d5c50]/40 text-[#ffd65a]">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.251.11a3.371 3.371 0 003.498 0L13 15.012m-3-5.636l.251-.11a3.371 3.371 0 003.498 0L13 9.013M9 10.5h6m-3-4.5v12" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-white group-hover:text-[#ffd65a] transition-colors"><span data-lang-block="en">VIP Progression & Store</span><span data-lang-block="fa">پیشرفت VIP و فروشگاه</span></h3>
          <p class="text-[#a2beba] text-sm leading-relaxed">
            <span data-lang-block="en">Gain coins and XP, level up your profile, and purchase items or VIP subscriptions integrated with CafeBazaar, Myket, and RevenueCat.</span><span data-lang-block="fa">سکه و تجربه جمع کنید، سطح پروفایلتان را بالا ببرید و آیتم‌ها یا اشتراک VIP را از طریق کافه‌بازار، مایکت و RevenueCat بخرید.</span>
          </p>
        </div>
      </div>
    </section>

    <!-- Card Scoring & Game Rules -->
    <section class="max-w-7xl mx-auto px-6 py-16 border-t border-[#1d5c50]/30" id="section-rules">
      <div class="text-center mb-16 space-y-4">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white"><span data-lang-block="en">How to Score Points</span><span data-lang-block="fa">نحوه‌ی امتیازگیری</span></h2>
        <div class="w-20 h-1 bg-gradient-to-r from-[#ffd65a] to-[#ffe4b0] mx-auto rounded-full"></div>
        <p class="text-[#a2beba] max-w-2xl mx-auto"><span data-lang-block="en">4Barg points are calculated at the end of each round based on the specific cards collected in your pile.</span><span data-lang-block="fa">امتیازهای چهاربرگ در پایان هر دور بر اساس کارت‌هایی که جمع کرده‌اید حساب می‌شود.</span></p>
      </div>

      <!-- Point cards grid -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6 justify-center">
        <!-- Jack -->
        <div class="card-point-showcase" id="card-rule-jack">
          <div class="card-point-badge"><span data-lang-block="en">+1 Point</span><span data-lang-block="fa">+۱ امتیاز</span></div>
          <div class="rule-playing-card">
            <img src="/4barg/cards/spades_jack.png" alt="Jack of Spades" data-alt-en="Jack of Spades" data-alt-fa="سرباز پیک" class="w-full h-full object-contain" />
          </div>
          <div class="text-center mt-3">
            <h4 class="font-bold text-white text-sm"><span data-lang-block="en">Jack (سرباز)</span><span data-lang-block="fa">سرباز</span></h4>
            <p class="text-xs text-[#a2beba] mt-1"><span data-lang-block="en">Gives 1 point and collects all cards on the table.</span><span data-lang-block="fa">۱ امتیاز دارد و همه‌ی کارت‌های روی میز را جمع می‌کند.</span></p>
          </div>
        </div>

        <!-- Ace -->
        <div class="card-point-showcase" id="card-rule-ace">
          <div class="card-point-badge"><span data-lang-block="en">+1 Point</span><span data-lang-block="fa">+۱ امتیاز</span></div>
          <div class="rule-playing-card">
            <img src="/4barg/cards/clubs_ace.png" alt="Ace of Clubs" data-alt-en="Ace of Clubs" data-alt-fa="تک خاج" class="w-full h-full object-contain" />
          </div>
          <div class="text-center mt-3">
            <h4 class="font-bold text-white text-sm"><span data-lang-block="en">Ace (تک)</span><span data-lang-block="fa">تک</span></h4>
            <p class="text-xs text-[#a2beba] mt-1"><span data-lang-block="en">Each Ace collected in your pile adds 1 point.</span><span data-lang-block="fa">هر تکی که جمع کنید ۱ امتیاز دارد.</span></p>
          </div>
        </div>

        <!-- 10 of Diamonds -->
