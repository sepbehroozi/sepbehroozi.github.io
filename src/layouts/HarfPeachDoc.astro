---
import '@fontsource-variable/vazirmatn';
import '@fontsource-variable/figtree';
import '../styles/harfpeach.css';
import HpThemeInit from '../components/harfpeach/HpThemeInit.astro';
import HpThemeToggle from '../components/harfpeach/HpThemeToggle.astro';
import HpFooter from '../components/harfpeach/HpFooter.astro';
import HpSmoothScroll from '../components/harfpeach/HpSmoothScroll.astro';

type Page = 'privacy' | 'terms' | 'delete';
interface LangStrings {
  /** Browser-tab title. */
  title: string;
  /** Page heading. */
  heading: string;
  /** One line under the heading. */
  lead: string;
}
interface Props {
  current: Page;
  description: string;
  en: LangStrings;
  fa: LangStrings;
}
const { current, description, en, fa } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/harfpeach/og.png', Astro.site).toString();
const langTitles = { en: en.title, fa: fa.title };

const docs: { id: Page; href: string; fa: string; en: string }[] = [
  { id: 'privacy', href: '/harfpeach/privacy_policy', fa: 'حریم خصوصی', en: 'Privacy' },
  { id: 'terms', href: '/harfpeach/terms_of_service', fa: 'شرایط استفاده', en: 'Terms' },
  { id: 'delete', href: '/harfpeach/delete_account', fa: 'حذف حساب', en: 'Delete account' },
];
---
<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{en.title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/harfpeach/favicon.png" />
    <link rel="apple-touch-icon" href="/harfpeach/apple-touch-icon.png" />
    <meta name="theme-color" content="#FFEBDD" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1D1310" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={en.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={en.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <HpThemeInit />
    <script is:inline define:vars={{ langTitles }}>
      // Decide the language before first paint so the right copy shows
      // without a flash. `?lang=` wins; otherwise the browser language
      // (Persian -> fa), then English.
      (function () {
        try {
          var lang = new URLSearchParams(window.location.search).get('lang');
          if (lang !== 'en' && lang !== 'fa') {
            lang = (navigator.language || '').toLowerCase().indexOf('fa') === 0 ? 'fa' : 'en';
          }
          var root = document.documentElement;
          root.setAttribute('data-lang', lang);
          root.lang = lang;
          root.dir = lang === 'fa' ? 'rtl' : 'ltr';
          document.title = langTitles[lang];
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="hp">
      <header class="hp-header">
        <div class="hp-wrap hp-nav">
          <a href="/harfpeach" class="hp-brand" data-keep-lang>
            <img src="/harfpeach/icon.webp" alt="" width="44" height="44" />
            <span class="hp-brand-text">
              <span class="hp-brand-fa">حرف‌پیچ</span>
              <span class="hp-brand-en" lang="en" dir="ltr">Harf Peach</span>
            </span>
          </a>
          <div class="hp-nav-actions">
            <button type="button" class="hp-candy hp-btn-plain hp-btn-sm hp-lang-btn" data-lang-toggle>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M3 12h18"></path>
                <path d="M12 3c2.5 2.5 3.8 5.7 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.7-3.8-9S9.5 5.5 12 3z"></path>
              </svg>
              <span data-lang-block="en" lang="fa">فارسی</span>
              <span data-lang-block="fa" lang="en">English</span>
            </button>
            <HpThemeToggle label="Light or dark mode" />
          </div>
        </div>
      </header>

      <main>
        <section class="hp-doc-head">
          <div class="hp-doc-blob" aria-hidden="true"></div>
          <div class="hp-wrap hp-doc-head-inner">
            <h1 class="hp-doc-title" data-lang-block="en">{en.heading}</h1>
            <h1 class="hp-doc-title" data-lang-block="fa">{fa.heading}</h1>
            <p class="hp-doc-lead" data-lang-block="en">{en.lead}</p>
            <p class="hp-doc-lead" data-lang-block="fa">{fa.lead}</p>
            <nav class="hp-doc-switch" aria-label="Harf Peach documents">
              {docs.map((d) => (
                <a href={d.href} data-keep-lang aria-current={d.id === current ? 'page' : undefined}>
                  <span data-lang-block="en">{d.en}</span>
                  <span data-lang-block="fa">{d.fa}</span>
                </a>
              ))}
            </nav>
          </div>
        </section>

        <slot />
      </main>

      <HpFooter current={current} bilingual />
    </div>

    <HpSmoothScroll />

    <script is:inline define:vars={{ langTitles }}>
      // Language toggle: flip the language, direction, tab title and `?lang=`
      // (so the current view is shareable), and carry the language over to
      // every Harf Peach link on the page.
      (function () {
        var root = document.documentElement;
        function syncLinks(lang) {
          document.querySelectorAll('a[data-keep-lang]').forEach(function (a) {
            var url = new URL(a.getAttribute('href'), window.location.href);
            url.searchParams.set('lang', lang);
            a.setAttribute('href', url.pathname + url.search + url.hash);
          });
        }
        function apply(lang) {
          root.setAttribute('data-lang', lang);
          root.lang = lang;
          root.dir = lang === 'fa' ? 'rtl' : 'ltr';
          document.title = langTitles[lang];
          var url = new URL(window.location.href);
          url.searchParams.set('lang', lang);
          window.history.replaceState(null, '', url.pathname + url.search + url.hash);
          syncLinks(lang);
        }
        syncLinks(root.getAttribute('data-lang') === 'fa' ? 'fa' : 'en');
        document.querySelectorAll('[data-lang-toggle]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            apply(root.getAttribute('data-lang') === 'fa' ? 'en' : 'fa');
          });
        });
      })();
    </script>

    <style is:global>
      /* Show only the active language. Without JavaScript (no data-lang),
         English shows. */
      html:not([data-lang="fa"]) [data-lang-block="fa"] { display: none !important; }
      html[data-lang="fa"] [data-lang-block="en"] { display: none !important; }
      html:not([data-lang="fa"]) body { font-family: 'Figtree Variable', 'Vazirmatn Variable', system-ui, sans-serif; }

      .hp-lang-btn { font-size: 15px; padding: 0 16px; }

      .hp-doc-head { position: relative; z-index: 0; isolation: isolate; }
      .hp-doc-blob {
        position: absolute; z-index: -1; width: 460px; height: 460px; border-radius: 50%;
        background: var(--blob-peach); top: -300px; inset-inline-end: -140px;
      }
      .hp-doc-head-inner { padding-top: 40px; padding-bottom: 48px; display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
      .hp-doc-title { font-size: 48px; line-height: 1.25; font-weight: 900; letter-spacing: -0.01em; }
      html[data-lang="fa"] .hp-doc-title { letter-spacing: 0; line-height: 1.4; }
      .hp-doc-lead { font-size: 18px; line-height: 1.8; color: var(--muted); max-width: 52ch; }
      .hp-doc-switch { display: flex; flex-wrap: wrap; gap: 10px; padding-top: 14px; }
      .hp .hp-doc-switch a {
        height: 42px; padding: 0 18px; border-radius: 14px; display: inline-flex; align-items: center;
        font-size: 15px; font-weight: 700; color: var(--text); background: var(--surface);
        box-shadow: 0 4px 0 var(--shadow); transition: transform .16s var(--ease);
      }
      .hp-doc-switch a:hover { transform: translateY(-2px); }
      .hp-doc-switch a:active { transform: translateY(3px); }
      .hp .hp-doc-switch a[aria-current="page"] { color: #FFFFFF; background: var(--peach-face); box-shadow: 0 4px 0 var(--peach-shadow); }

      @media (max-width: 900px) {
        .hp-doc-title { font-size: 34px; }
        .hp-doc-head-inner { padding-top: 24px; padding-bottom: 32px; }
      }
      @media (prefers-reduced-motion: reduce) {
        .hp-doc-switch a { transition: none; }
      }
    </style>
  </body>
</html>
