---
import '@fontsource-variable/vazirmatn';
import '../styles/global.css';
interface Frontmatter {
  title?: string;
  description?: string;
}
interface LangStrings {
  title: string;
  heading: string;
  back: string;
}
interface Props {
  frontmatter?: Frontmatter;
  title?: string;
  description?: string;
  /**
   * When set, the page renders in bilingual mode: a language toggle appears
   * top-right, the active language is chosen from `?lang=` (falling back to the
   * browser language, then English), and the whole page — heading, back link,
   * tab title, and text direction — switches with it. The page is expected to
   * provide the content itself as two `[data-lang-block]` articles in the slot.
   * With `defaultLang: 'fa'`, Persian is shown unless `?lang=en` asks for
   * English. `backHref` is where the back link goes (default `/`).
   */
  bilingual?: { en: LangStrings; fa: LangStrings; defaultLang?: 'en' | 'fa'; backHref?: string };
}
const props = Astro.props;
const { title, description } = props.frontmatter ?? props;
const bilingual = props.bilingual;
const fullTitle = title ?? 'Sep Behroozi';
const desc = description ?? 'Software engineer.';
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const langTitles = bilingual
  ? { en: bilingual.en.title, fa: bilingual.fa.title }
  : null;
const defaultLang = bilingual?.defaultLang ?? null;
const backHref = bilingual?.backHref ?? '/';
// Render the default language on the server, so the page is right before
// (and without) script.
const initialLang = defaultLang ?? 'en';
---
<!DOCTYPE html>
<html
  lang={initialLang}
  dir={initialLang === 'fa' ? 'rtl' : 'ltr'}
  data-lang={defaultLang ?? undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.site).toString()} />
    {bilingual && (
      <script is:inline define:vars={{ langTitles, defaultLang }}>
        // Decide the language before first paint so the correct content shows
        // without a flash. `?lang=` wins; otherwise the page's default
        // language, or failing that the browser language (Persian → fa),
        // then English.
        (function () {
          try {
            var params = new URLSearchParams(window.location.search);
            var lang = params.get('lang');
            if (lang !== 'en' && lang !== 'fa') {
              lang = defaultLang || ((navigator.language || '').toLowerCase().indexOf('fa') === 0 ? 'fa' : 'en');
            }
            var root = document.documentElement;
            root.setAttribute('data-lang', lang);
            root.lang = lang;
            root.dir = lang === 'fa' ? 'rtl' : 'ltr';
            if (langTitles && langTitles[lang]) document.title = langTitles[lang];
          } catch (e) {}
        })();
      </script>
    )}
  </head>
  <body class="bg-ink-base text-[color:var(--text-primary)]">
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 -z-10"
      style="background: radial-gradient(120% 80% at 0% 0%, var(--bg-radial-from) 0%, var(--bg-base) 60%);"
    ></div>

    <main class="mx-auto max-w-2xl px-6 py-16">
      {bilingual ? (
        <>
          <div class="legal-topbar">
            <a href={backHref} class="label-eyebrow legal-back" data-lang-block="en" data-keep-lang>{bilingual.en.back}</a>
            <a href={backHref} class="label-eyebrow legal-back" data-lang-block="fa" data-keep-lang>{bilingual.fa.back}</a>
            <button type="button" class="lang-toggle" data-lang-toggle aria-label="Switch language">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M3 12h18" />
                <path d="M12 3c2.5 2.5 3.8 5.7 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.7-3.8-9S9.5 5.5 12 3z" />
              </svg>
              <span data-lang-block="en">فارسی</span>
              <span data-lang-block="fa">English</span>
            </button>
          </div>
          <h1 class="text-3xl md:text-4xl font-semibold mb-2" data-lang-block="en">{bilingual.en.heading}</h1>
          <h1 class="text-3xl md:text-4xl font-semibold mb-2" data-lang-block="fa">{bilingual.fa.heading}</h1>
          <slot />
        </>
      ) : (
        <>
          <a
            href="/"
            class="label-eyebrow inline-block mb-8 hover:text-[color:var(--text-secondary)] transition-colors"
          >&larr; Sep Behroozi</a>
          <h1 class="text-3xl md:text-4xl font-semibold mb-2">{fullTitle}</h1>
          <article class="legal-prose">
            <slot />
          </article>
        </>
      )}
    </main>

    {bilingual && (
      <script is:inline define:vars={{ langTitles, defaultLang }}>
        // Wire the language toggle: flip the language, update direction, tab
        // title, and the URL (`?lang=`) so the current view is shareable.
        // Links marked data-keep-lang carry the language along (left off when
        // it is the default).
        (function () {
          function syncLinks(lang) {
            document.querySelectorAll('a[data-keep-lang]').forEach(function (a) {
              var url = new URL(a.getAttribute('href'), window.location.href);
              if (defaultLang && lang === defaultLang) url.searchParams.delete('lang');
              else url.searchParams.set('lang', lang);
              a.setAttribute('href', url.pathname + url.search + url.hash);
            });
          }
          syncLinks(document.documentElement.getAttribute('data-lang') === 'fa' ? 'fa' : 'en');
          function apply(lang) {
            var root = document.documentElement;
            root.setAttribute('data-lang', lang);
            root.lang = lang;
            root.dir = lang === 'fa' ? 'rtl' : 'ltr';
            if (langTitles && langTitles[lang]) document.title = langTitles[lang];
            var url = new URL(window.location.href);
            url.searchParams.set('lang', lang);
            window.history.replaceState(null, '', url.pathname + url.search + url.hash);
            syncLinks(lang);
          }
          document.querySelectorAll('[data-lang-toggle]').forEach(function (btn) {
            btn.addEventListener('click', function () {
              var current = document.documentElement.getAttribute('data-lang') === 'fa' ? 'fa' : 'en';
              apply(current === 'fa' ? 'en' : 'fa');
            });
          });
        })();
      </script>
    )}

    <style is:global>
      .legal-prose {
        color: var(--text-secondary);
        line-height: 1.7;
        font-size: 1rem;
      }
      .legal-prose h1, .legal-prose h2, .legal-prose h3, .legal-prose h4 {
        color: var(--text-primary);
        font-weight: 600;
        margin-top: 2em;
        margin-bottom: 0.5em;
        line-height: 1.25;
      }
      .legal-prose h1 { font-size: 1.75rem; }
      .legal-prose h2 { font-size: 1.4rem; }
      .legal-prose h3 { font-size: 1.15rem; }
      .legal-prose p { margin-bottom: 1em; }
      .legal-prose ul, .legal-prose ol { margin: 1em 0; padding-left: 1.5em; }
      .legal-prose li { margin-bottom: 0.4em; }
      .legal-prose a {
        color: var(--accent-from);
        text-decoration: underline;
        text-decoration-color: rgba(196, 181, 253, 0.4);
        text-underline-offset: 2px;
      }
      .legal-prose a:hover {
        text-decoration-color: var(--accent-from);
      }
      .legal-prose strong { color: var(--text-primary); font-weight: 600; }
      .legal-prose code {
        background: var(--surface);
        border: 1px solid var(--surface-border);
        padding: 0.1em 0.4em;
        border-radius: 4px;
        font-size: 0.9em;
      }
      /* Allow inline image styling (used in power-optimization-settings.md) */
      .legal-prose img { max-width: 100%; vertical-align: middle; }

      /* --- Bilingual mode --- */
      /* Show only the active language's blocks. Default (no data-lang set, e.g.
         JavaScript disabled) shows English and hides Persian. */
      html:not([data-lang="fa"]) [data-lang-block="fa"] { display: none; }
      html[data-lang="fa"] [data-lang-block="en"] { display: none; }

      html[data-lang="fa"] body { font-family: 'Vazirmatn Variable', var(--font-sans); }
      html[data-lang="fa"] .legal-prose { line-height: 2; }
      /* The eyebrow style is monospace and letter-spaced, which pulls Persian
         letters apart. */
      html[data-lang="fa"] .legal-back { font-family: 'Vazirmatn Variable', var(--font-sans); letter-spacing: 0; font-size: 0.85rem; }

      /* Right-to-left list bullets sit on the correct side in Persian. */
      html[data-lang="fa"] .legal-prose ul,
      html[data-lang="fa"] .legal-prose ol {
        padding-left: 0;
        padding-right: 1.5em;
      }

      .legal-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 2rem;
      }
      .legal-back {
        display: inline-block;
        transition: color 0.15s ease;
      }
      .legal-back:hover { color: var(--text-secondary); }
      .lang-toggle {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.35rem 0.7rem;
        border: 1px solid var(--surface-border);
        border-radius: 999px;
        background: var(--surface);
        color: var(--text-secondary);
        font-size: 0.85rem;
        cursor: pointer;
        transition: color 0.15s ease, border-color 0.15s ease;
      }
      .lang-toggle:hover {
        color: var(--text-primary);
        border-color: var(--accent-from);
      }
    </style>
  </body>
</html>
