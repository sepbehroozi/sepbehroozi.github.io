---
// Fixed decorative backdrop, two variants:
//   'orbs' (default) — the original drifting gradient orbs. Used by the
//     4barg pages, which recolor the orbs via [data-orb] CSS overrides.
//   'grid' — a quiet instrument grid for the portfolio, like the ruled
//     background of a trace/oscilloscope readout. Static, no orbs.
interface Props {
  variant?: 'orbs' | 'grid';
}
const { variant = 'orbs' } = Astro.props;
---
{variant === 'grid' ? (
  <div aria-hidden="true" class="backdrop">
    <div class="backdrop-grid"></div>
    <div class="backdrop-fade"></div>
  </div>
) : (
  <div aria-hidden="true" class="backdrop">
    <div class="backdrop-gradient"></div>
    <div class="backdrop-orb backdrop-orb-1" data-orb="1"></div>
    <div class="backdrop-orb backdrop-orb-2" data-orb="2"></div>
    <div class="backdrop-orb backdrop-orb-3" data-orb="3"></div>
  </div>
)}

<style>
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: -10;
    pointer-events: none;
    overflow: hidden;
  }

  /* grid variant */
  .backdrop-grid {
    position: absolute;
    inset: 0;
    background-color: var(--ink-0);
    background-image:
      linear-gradient(var(--hairline) 1px, transparent 1px),
      linear-gradient(90deg, var(--hairline) 1px, transparent 1px);
    background-size: 64px 64px;
    opacity: 0.35;
    mask-image: radial-gradient(120% 70% at 50% 0%, #000 0%, transparent 75%);
    -webkit-mask-image: radial-gradient(120% 70% at 50% 0%, #000 0%, transparent 75%);
  }
  .backdrop-fade {
    position: absolute;
    inset: 0;
    background: radial-gradient(60% 40% at 15% 0%, rgba(95, 216, 196, 0.05), transparent 70%);
  }

  /* orbs variant (legacy — 4barg) */
  .backdrop-gradient {
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 80% at 0% 0%, var(--bg-radial-from) 0%, var(--bg-base) 60%);
  }
  .backdrop-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    opacity: 0.55;
    will-change: transform;
  }
  .backdrop-orb-1 {
    width: 380px;
    height: 380px;
    top: -120px;
    left: -100px;
    background: radial-gradient(circle, var(--accent-from) 0%, transparent 70%);
    opacity: 0.35;
  }
  .backdrop-orb-2 {
    width: 460px;
    height: 460px;
    bottom: -160px;
    right: -120px;
    background: radial-gradient(circle, var(--accent-to) 0%, transparent 70%);
    opacity: 0.30;
  }
  .backdrop-orb-3 {
    width: 320px;
    height: 320px;
    top: 40%;
    left: 60%;
    background: radial-gradient(circle, #7c5cff 0%, transparent 70%);
    opacity: 0.25;
  }
</style>
