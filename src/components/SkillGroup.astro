---
import type { SkillGroup } from '../data/resume';
interface Props { group: SkillGroup; }
const { group } = Astro.props;
---
<div class="row" data-anim="reveal">
  <span class="key">{group.label}</span>
  <span class="value">{group.items.join('  ·  ')}</span>
</div>

<style>
  .row {
    display: grid;
    grid-template-columns: 132px 1fr;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--hairline);
    font-family: var(--font-mono);
    font-size: 0.86rem;
  }
  .row:last-child { border-bottom: none; }
  .key {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.72rem;
    color: var(--signal-dim);
    padding-top: 0.15rem;
  }
  .value { color: var(--mist); line-height: 1.6; }

  @media (max-width: 640px) {
    .row { grid-template-columns: 1fr; gap: 0.35rem; }
  }
</style>
