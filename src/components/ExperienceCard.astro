---
import type { Experience } from '../data/resume';
import { formatRange } from '../utils/formatRange';
interface Props { item: Experience; current?: boolean; }
const { item, current = false } = Astro.props;
---
<article class="stage" data-anim="reveal">
  <header class="row">
    <div class="title">
      <span class="company font-display">{item.company}</span>
      {current && <span class="live font-mono">live</span>}
      <span class="role">{item.role}</span>
    </div>
    <span class="dates tabular font-mono">{formatRange(item.range)}</span>
  </header>
  {item.location && <p class="location font-mono">{item.location}</p>}
  <ul class="bullets">
    {item.bullets.map((b) => <li>{b}</li>)}
  </ul>
  {item.links && (
    <ul class="links">
      {item.links.map((l) => (
        <li><a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a></li>
      ))}
    </ul>
  )}
</article>

<style>
  .stage {
    padding: 0.4rem 0 1.9rem;
    transition: transform 0.18s ease;
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .title { display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap; }
  .company { font-size: 1.15rem; font-weight: 600; color: var(--paper); }
  .role { color: var(--mist); font-size: 0.95rem; }
  .live {
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-0);
    background: var(--signal);
    padding: 0.12rem 0.4rem;
    border-radius: 2px;
  }
  .dates { color: var(--mist-dim); font-size: 0.82rem; }
  .location {
    color: var(--mist-dim);
    font-size: 0.78rem;
    margin: 0.3rem 0 0.7rem 0;
  }
  .bullets {
    margin: 0.5rem 0 0 0;
    padding-left: 1.1rem;
    color: var(--mist);
    line-height: 1.6;
    font-size: 0.93rem;
  }
  .bullets li { margin-bottom: 0.4em; }
  .bullets li::marker { color: var(--trace-dim); }
  .links {
    list-style: none;
    padding: 0;
    margin: 0.8rem 0 0 0;
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }
  .links a {
    color: var(--trace);
    text-decoration: none;
    font-size: 0.85rem;
    font-family: var(--font-mono);
  }
  .links a:hover { text-decoration: underline; }
</style>
