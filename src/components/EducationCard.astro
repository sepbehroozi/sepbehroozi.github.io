---
import type { Education } from '../data/resume';
import { formatRange } from '../utils/formatRange';
interface Props { item: Education; }
const { item } = Astro.props;
---
<article class="edu" data-anim="reveal">
  <header class="row">
    <span class="institution">{item.institution}</span>
    <span class="dates tabular font-mono">{formatRange(item.range)}</span>
  </header>
  <p class="degree">{item.degree}</p>
  {item.notes && <p class="notes">{item.notes}</p>}
</article>

<style>
  .edu { display: flex; flex-direction: column; gap: 0.3rem; }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .institution { font-weight: 600; color: var(--paper); }
  .dates { color: var(--mist-dim); font-size: 0.8rem; }
  .degree { color: var(--mist); margin: 0; font-size: 0.92rem; }
  .notes { color: var(--mist-dim); margin: 0; font-size: 0.82rem; }
</style>
