---
import { resume } from '../data/resume';
import Avatar from './Avatar.astro';
import ContactLinks from './ContactLinks.astro';
import DownloadCV from './DownloadCV.astro';
const { identity, stats, resumePdf } = resume;
---
<header class="hero" data-anim="hero">
  <div class="hero-top">
    <Avatar src={identity.photo} alt={`Photo of ${identity.name}`} />
    <div class="identity">
      <p class="eyebrow label-eyebrow">{identity.location}</p>
      <h1 class="name font-display">{identity.name}</h1>
      <p class="role">{identity.role}</p>
    </div>
  </div>

  <p class="tagline">{identity.tagline}</p>

  <ul class="stats font-mono tabular" aria-label="Career stats at a glance">
    {stats.map((s) => (
      <li class="stat">
        <span class="stat-value">{s.value}</span>
        <span class="stat-label">{s.label}</span>
      </li>
    ))}
  </ul>

  <div class="cta-row">
    <DownloadCV href={resumePdf} />
    <ContactLinks links={identity.contact} />
  </div>
</header>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--hairline);
  }
  .hero-top {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .identity { display: flex; flex-direction: column; gap: 0.3rem; }
  .eyebrow { margin: 0; }
  .name {
    font-size: clamp(2rem, 5vw, 2.9rem);
    font-weight: 600;
    line-height: 1.05;
    margin: 0;
    letter-spacing: -0.01em;
    color: var(--paper);
  }
  .role {
    color: var(--trace);
    font-size: 1.02rem;
    font-family: var(--font-mono);
    margin: 0;
  }
  .tagline {
    color: var(--mist);
    font-size: 1.08rem;
    line-height: 1.6;
    max-width: 56ch;
    margin: 0;
  }

  .stats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0;
    font-size: 0.85rem;
  }
  .stat { display: inline-flex; align-items: baseline; }
  .stat:not(:last-child)::after {
    content: '·';
    margin: 0 0.75rem;
    color: var(--mist-dim);
  }
  .stat-value { color: var(--signal); font-weight: 600; margin-right: 0.4em; }
  .stat-label { color: var(--mist-dim); }

  .cta-row {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  @media (max-width: 560px) {
    .hero-top { align-items: flex-start; gap: 1rem; }
  }
</style>
