---
interface Props {
  src: string;
  alt: string;
  size?: number;
}
const { src, alt, size = 108 } = Astro.props;
---
<div class="avatar" style={`--size:${size}px;`}>
  <svg class="reticle" viewBox="0 0 100 100" aria-hidden="true">
    <path d="M2 16V2H16" />
    <path d="M84 2H98V16" />
    <path d="M98 84V98H84" />
    <path d="M16 98H2V84" />
  </svg>
  <img src={src} alt={alt} width={size} height={size} loading="eager" decoding="async" />
</div>

<style>
  .avatar {
    position: relative;
    width: var(--size);
    height: var(--size);
    flex: 0 0 auto;
    padding: 10px;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 4px;
    filter: grayscale(0.25) contrast(1.05);
    background: var(--ink-1);
    position: relative;
    z-index: 1;
  }
  .reticle {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--trace-dim);
    stroke-width: 1.5;
    z-index: 2;
  }
</style>
