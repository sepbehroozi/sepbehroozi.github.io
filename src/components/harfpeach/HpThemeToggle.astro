---
interface Props {
  /** Accessible name; Persian by default. */
  label?: string;
}
const { label = 'تغییر حالت روشن و تاریک' } = Astro.props;
---
<button type="button" class="hp-candy hp-theme-btn" data-hp-theme aria-label={label}>
  <svg class="hp-icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
  <svg class="hp-icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
</button>

<script is:inline>
  // Flip whichever theme is showing and remember the choice.
  (function () {
    var root = document.documentElement;
    document.querySelectorAll('[data-hp-theme]').forEach(function (btn) {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', function () {
        var t = root.getAttribute('data-theme');
        var dark = t ? t === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        var next = dark ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('hp-theme', next); } catch (e) {}
      });
    });
  })();
</script>
