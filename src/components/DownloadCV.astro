---
interface Props { href: string; }
const { href } = Astro.props;
---
<a class="dl-cv" href={href} download>
  <span class="dl-cv-label">Download résumé</span>
  <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
    <path d="M12 3v12m0 0l-4-4m4 4l4-4M4 21h16" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</a>

<style>
  .dl-cv {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.65rem 1.1rem;
    border-radius: 3px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.85rem;
    letter-spacing: 0.01em;
    color: var(--signal);
    background: transparent;
    border: 1px solid var(--signal-dim);
    text-decoration: none;
    transition: background 0.18s ease, border-color 0.18s ease, transform 0.15s ease;
  }
  .dl-cv:hover {
    background: rgba(255, 180, 84, 0.08);
    border-color: var(--signal);
    transform: translateY(-1px);
  }
  .dl-cv svg { flex: 0 0 auto; }
</style>
